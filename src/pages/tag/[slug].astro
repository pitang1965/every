---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import EntryCard from "../../components/EntryCard.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
// WordPress から来た日本語スラッグは「%e7%be%a4...」のまま保存されているので、エンコード後の形でも照合する
const encodedSlug = slug ? encodeURIComponent(slug).toLowerCase() : null;
const term = slug
	? termsResult.data.find(
			(item) => item.slug === slug || item.slug.toLowerCase() === encodedSlug,
		)
	: null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);
---

<Base title={`タグ「${term.label}」の記事`} description={`タグ「${term.label}」の記事`}>
	<h1>タグ：{term.label}</h1>

	{
		posts.length === 0 ? (
			<p>このタグの記事はまだありません。</p>
		) : (
			posts.map((post) => <EntryCard post={post} category={categoriesByEntry.get(post.data.id)?.[0]} />)
		)
	}
	<nav class="pagination" aria-label="ページ送り">
		{cursor && <a href={`/tag/${term.slug}`}>最初のページ</a>}
		{
			nextCursor && (
				<a href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}>次のページ</a>
			)
		}
	</nav>
</Base>
