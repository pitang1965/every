---
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import EntryCard from "../components/EntryCard.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

// トップが唯一の記事一覧（元サイトと同じ）。/posts はここへ転送している
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// 一覧全体のカテゴリを1回のクエリでまとめて取得
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
);
---

<Base title={siteTitle} description={siteTagline}>
	{
		posts.length === 0 ? (
			<p>
				まだ記事がありません。<a href="/_emdash/admin/content/posts/new">記事を書く</a>
			</p>
		) : (
			posts.map((post) => (
				<EntryCard post={post} category={categoriesByEntry.get(post.data.id)?.[0]} />
			))
		)
	}
	{
		(cursor || nextCursor) && (
			<nav class="pagination" aria-label="ページ送り">
				{cursor && <a href="/">最初のページ</a>}
				{nextCursor && <a href={`/?cursor=${encodeURIComponent(nextCursor)}`}>次のページ</a>}
			</nav>
		)
	}
</Base>
