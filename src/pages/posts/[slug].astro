---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { contentComponents } from "../../components/portable-text";
import { formatDate } from "../../utils/format";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		<h1 class="entry-title" {...post.edit.title}>{post.data.title}</h1>

		{
			post.data.featured_image && (
				<figure class="eye-catch" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
					{categories[0] && <span class="cat-label">{categories[0].label}</span>}
				</figure>
			)
		}

		{
			post.data.publishedAt && (
				<div class="date-tags">
					<time datetime={post.data.publishedAt.toISOString()}>
						{formatDate(post.data.publishedAt)}
					</time>
				</div>
			)
		}

		<div class="entry-content">
			<PortableText
				value={post.data.content}
				components={contentComponents}
			/>
		</div>

		{
			(categories.length > 0 || tags.length > 0) && (
				<div class="tax-links">
					{categories.map((c) => (
						<a class="tax-link" href={`/category/${c.slug}`}>{c.label}</a>
					))}
					{tags.map((t) => (
						<a class="tax-link" href={`/tag/${t.slug}`}>#{t.label}</a>
					))}
				</div>
			)
		}
	</article>

</Base>
