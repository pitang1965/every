---
import { getOgp, type Ogp } from "../utils/ogp";

interface Props {
	url: string;
	/** 内容が決まっているカードは渡せば外部取得しない */
	ogp?: Ogp;
}

const ogp = Astro.props.ogp ?? (await getOgp(Astro.props.url));
---

<a href={ogp.url} class="blogcard" target="_blank" rel="noopener noreferrer">
	{ogp.image && <img class="blogcard-thumb" src={ogp.image} alt="" loading="lazy" />}
	<div class="blogcard-content">
		<div class="blogcard-title">{ogp.title}</div>
		{ogp.description && <div class="blogcard-snippet">{ogp.description}</div>}
		<div class="blogcard-site">{ogp.host}</div>
	</div>
</a>
